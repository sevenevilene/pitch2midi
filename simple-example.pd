#N canvas 100 100 560 380 12;
#X obj 30 30 adc~;
#X obj 30 80 pitch2midi~ 1 -50;
#X floatatom 30 140 5 0 0 0 note - - 0;
#X floatatom 130 140 5 0 0 0 velocity - - 0;
#X obj 30 200 pack f f;
#X obj 30 240 print note;
#X msg 300 30 \; pd dsp 1;
#X text 300 80 1 click "pd dsp 1" to start audio;
#X text 300 105 2 sing or play one note at a time;
#X text 300 130 3 notes go to MIDI out + the outlets;
#X connect 0 0 1 0;
#X connect 1 0 2 0;
#X connect 1 1 3 0;
#X connect 1 0 4 0;
#X connect 1 1 4 1;
#X connect 4 0 5 0;
