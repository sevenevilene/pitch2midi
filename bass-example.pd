#N canvas 100 100 760 520 12;
#X obj 30 60 adc~ 1;
#X obj 30 110 pitch2midi-bass~ 1 -50 2;
#X floatatom 30 170 5 0 0 0 note - - 0;
#X floatatom 110 170 5 0 0 0 velocity - - 0;
#X floatatom 200 170 7 0 0 0 Hz - - 0;
#X floatatom 290 170 6 0 0 0 bend - - 0;
#X msg 420 20 \; pd dsp 1;
#X text 420 70 1 click "pd dsp 1" to start audio;
#X text 420 95 2 plug the bass into audio input 1 and play single notes;
#X text 420 145 3 notes go to Pd's MIDI out (Preferences > MIDI) on channel 1;
#X floatatom 420 230 5 0 0 0 threshold-dBFS - - 0;
#X msg 420 260 thresh \$1;
#X text 420 295 default -50: raise it (e.g. -40) if string / fret noise triggers notes \, lower it (e.g. -60) for a quiet bass;
#X obj 30 250 tgl 18 0 empty empty listen 22 9 0 12 #fcfcfc #000000 #000000 0 1;
#X obj 30 330 +;
#X obj 120 260 / 4096;
#X obj 120 290 t b f;
#X obj 30 360 mtof;
#X obj 30 390 phasor~;
#X obj 30 420 lop~ 600;
#X obj 200 330 / 127;
#X obj 200 360 pack f 10;
#X obj 200 390 line~;
#X obj 30 450 *~;
#X obj 30 480 *~ 0;
#X obj 120 480 *~ 0.2;
#X obj 220 480 dac~;
#X text 420 440 listen: a tiny built-in synth so you can hear the result without an external synth (follows the pitch bend too);
#X obj 420 350 tgl 18 0 empty empty pitch-bend 22 9 0 12 #fcfcfc #000000 #000000 0 1;
#X msg 420 380 bend \$1;
#X text 560 345 pitch bend on / off (off at start) \, range 2 semitones: set your synth to match;
#X obj 120 230 spigot;
#X obj 520 380 sel 0;
#X msg 520 405 0;
#X obj 520 430 bendout;
#X obj 300 20 loadbang;
#X msg 300 50 0;
#X connect 0 0 1 0;
#X connect 1 0 2 0;
#X connect 1 1 3 0;
#X connect 1 2 4 0;
#X connect 1 3 5 0;
#X connect 10 0 11 0;
#X connect 11 0 1 1;
#X connect 1 0 14 0;
#X connect 1 3 31 0;
#X connect 31 0 15 0;
#X connect 15 0 16 0;
#X connect 16 1 14 1;
#X connect 16 0 14 0;
#X connect 14 0 17 0;
#X connect 17 0 18 0;
#X connect 18 0 19 0;
#X connect 19 0 23 0;
#X connect 1 1 20 0;
#X connect 20 0 21 0;
#X connect 21 0 22 0;
#X connect 22 0 23 1;
#X connect 23 0 24 0;
#X connect 13 0 24 1;
#X connect 24 0 25 0;
#X connect 25 0 26 0;
#X connect 25 0 26 1;
#X connect 28 0 29 0;
#X connect 29 0 1 1;
#X connect 28 0 31 1;
#X connect 28 0 32 0;
#X connect 32 0 33 0;
#X connect 33 0 15 0;
#X connect 33 0 34 0;
#X connect 35 0 36 0;
#X connect 36 0 28 0;
