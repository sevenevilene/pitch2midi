#N canvas 40 60 980 720 12;
#X text 20 10 pitch2midi~ - monophonic pitch detector: audio in -> MIDI notes out;
#X text 20 35 Pure Pd vanilla - no externals. Runs in plugdata Compiled Mode / Heavy (hvcc).;
#X obj 20 80 adc~;
#X obj 120 80 tgl 18 0 empty empty test-tone 22 9 0 12 #fcfcfc #000000 #000000 0 1;
#X obj 120 110 osc~ 220;
#X obj 120 140 *~;
#X text 470 80 control messages (right inlet):;
#X msg 470 110 thresh -40;
#X text 570 110 gate threshold in dBFS (default -50);
#X msg 470 140 stable 2;
#X text 570 140 extra 4 ms ticks a note must be stable (default 2);
#X msg 470 170 midi 0;
#X msg 530 170 midi 1;
#X text 600 170 MIDI port output off / on;
#X msg 470 200 channel 2;
#X text 570 200 MIDI channel 1-16;
#X msg 470 230 bend 0;
#X msg 530 230 bend 1;
#X text 600 230 pitch bend output off / on;
#X msg 470 260 bendrange 2;
#X text 570 260 synth bend range in semitones (default 2);
#X obj 20 250 pitch2midi~ 1 -50;
#X text 20 225 args: [pitch2midi~ <midi channel> <threshold dBFS> <bend range>];
#X floatatom 20 300 5 0 0 0 note - - 0;
#X floatatom 110 300 5 0 0 0 vel - - 0;
#X floatatom 200 300 7 0 0 0 Hz - - 0;
#X floatatom 310 300 6 0 0 0 bend - - 0;
#X text 20 335 outlets work like [notein]: velocity arrives first then note (velocity 0 = note off). Notes are also sent to [noteout] and the bend to [bendout] -> your MIDI out port. Set your synth's bend range to match bendrange.;
#X obj 20 390 pack f f;
#X obj 20 420 print pitch2midi;
#X text 300 390 example: drive a synth exactly like you would from [notein];
#X obj 300 420 pack f f;
#X obj 300 450 unpack f f;
#X obj 300 480 mtof;
#X obj 300 510 phasor~;
#X obj 380 480 / 127;
#X obj 380 510 pack f 10;
#X obj 380 540 line~;
#X obj 300 570 *~;
#X obj 300 600 *~ 0.1;
#X obj 300 630 dac~;
#X text 620 260 To use it from ANOTHER patch or app with [notein]: pick a virtual MIDI port as Pd's MIDI output (macOS: IAC Driver in Audio MIDI Setup). Inside the same patch just use the outlets.;
#X text 620 470 Bass guitar? Use [pitch2midi-bass~] instead: same interface \, range from low B (31 Hz) \, octave-error guard for weak low fundamentals.;
#X text 620 400 Tips: feed one monophonic source (voice / bass / guitar single notes). Range ~40 Hz - 2.5 kHz (MIDI 28-99). Latency ~1.5-3 periods + 10 ms (about 15 ms at A4 and 65 ms at low E2).;
#X msg 20 140 \; pd dsp 1;
#X connect 4 0 5 0;
#X connect 3 0 5 1;
#X connect 2 0 21 0;
#X connect 5 0 21 0;
#X connect 7 0 21 1;
#X connect 9 0 21 1;
#X connect 11 0 21 1;
#X connect 12 0 21 1;
#X connect 14 0 21 1;
#X connect 16 0 21 1;
#X connect 17 0 21 1;
#X connect 19 0 21 1;
#X connect 21 0 23 0;
#X connect 21 1 24 0;
#X connect 21 2 25 0;
#X connect 21 3 26 0;
#X connect 21 0 28 0;
#X connect 21 1 28 1;
#X connect 28 0 29 0;
#X connect 21 0 31 0;
#X connect 21 1 31 1;
#X connect 31 0 32 0;
#X connect 32 0 33 0;
#X connect 33 0 34 0;
#X connect 32 1 35 0;
#X connect 35 0 36 0;
#X connect 36 0 37 0;
#X connect 34 0 38 0;
#X connect 37 0 38 1;
#X connect 38 0 39 0;
#X connect 39 0 40 0;
#X connect 39 0 40 1;
