#N canvas 40 60 980 720 12;
#X text 20 10 pitch2midi~ - monophonic pitch detector: audio in -> MIDI notes out;
#X text 20 35 Pure Pd vanilla - no externals. Runs in plugdata Compiled Mode / Heavy (hvcc).;
#X obj 20 80 adc~;
#X obj 120 80 tgl 18 0 empty empty test-tone 22 9 0 12 #fcfcfc #000000 #000000 0 1;
#X obj 120 110 osc~ 220;
#X obj 120 140 *~;
#X text 470 80 control messages (right inlet):;
#X msg 470 110 thresh -40;
#X text 570 110 gate threshold in dBFS (default -50);
#X msg 470 140 stable 2;
#X text 570 140 extra 4 ms ticks a note must be stable (default 2);
#X msg 470 170 midi 0;
#X msg 530 170 midi 1;
#X text 600 170 MIDI port output off / on;
#X msg 470 200 channel 2;
#X text 570 200 MIDI channel 1-16;
#X obj 20 250 pitch2midi~ 1 -50;
#X text 20 225 args: [pitch2midi~ <midi channel> <threshold dBFS>];
#X floatatom 20 300 5 0 0 0 note - - 0;
#X floatatom 110 300 5 0 0 0 vel - - 0;
#X floatatom 200 300 7 0 0 0 Hz - - 0;
#X text 20 335 outlets work like [notein]: velocity arrives first then note (velocity 0 = note off). Notes are also sent to [noteout] -> your MIDI out port.;
#X obj 20 390 pack f f;
#X obj 20 420 print pitch2midi;
#X text 300 390 example: drive a synth exactly like you would from [notein];
#X obj 300 420 pack f f;
#X obj 300 450 unpack f f;
#X obj 300 480 mtof;
#X obj 300 510 phasor~;
#X obj 380 480 / 127;
#X obj 380 510 pack f 10;
#X obj 380 540 line~;
#X obj 300 570 *~;
#X obj 300 600 *~ 0.1;
#X obj 300 630 dac~;
#X text 620 260 To use it from ANOTHER patch or app with [notein]: pick a virtual MIDI port as Pd's MIDI output (macOS: IAC Driver in Audio MIDI Setup). Inside the same patch just use the outlets.;
#X text 620 400 Tips: feed one monophonic source (voice / bass / guitar single notes). Range ~40 Hz - 2.5 kHz (MIDI 28-99). Latency ~1.5-3 periods + 10 ms (about 15 ms at A4 and 65 ms at low E2).;
#X msg 20 140 \; pd dsp 1;
#X connect 4 0 5 0;
#X connect 3 0 5 1;
#X connect 2 0 16 0;
#X connect 5 0 16 0;
#X connect 7 0 16 1;
#X connect 9 0 16 1;
#X connect 11 0 16 1;
#X connect 12 0 16 1;
#X connect 14 0 16 1;
#X connect 16 0 18 0;
#X connect 16 1 19 0;
#X connect 16 2 20 0;
#X connect 16 0 22 0;
#X connect 16 1 22 1;
#X connect 22 0 23 0;
#X connect 16 0 25 0;
#X connect 16 1 25 1;
#X connect 25 0 26 0;
#X connect 26 0 27 0;
#X connect 27 0 28 0;
#X connect 26 1 29 0;
#X connect 29 0 30 0;
#X connect 30 0 31 0;
#X connect 28 0 32 0;
#X connect 31 0 32 1;
#X connect 32 0 33 0;
#X connect 33 0 34 0;
#X connect 33 0 34 1;
